FROM python:3.10

# Create user to comply with Hugging Face Docker Spaces (User 1000)
RUN useradd -m -u 1000 user

# Set env variables
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

# Switch to the new user
USER user
WORKDIR $HOME/app

# Copy requirements and install dependencies
COPY --chown=user backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application
COPY --chown=user . .

# Expose Hugging Face Space port
EXPOSE 7860

# Run the FastAPI app on port 7860 from the backend directory
CMD ["bash", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 7860"]
