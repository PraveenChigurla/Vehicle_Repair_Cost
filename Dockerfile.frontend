FROM node:18-alpine

# Set working directory
WORKDIR /app

# Add a non-root user (Hugging Face requirement)
RUN adduser -D -u 1000 user

# Copy package files and install dependencies
COPY frontend/package*.json ./
RUN npm install

# Copy all frontend files
COPY frontend/ ./

# Build the Next.js app
# The NEXT_PUBLIC_API_URL environment variable must be passed as a Docker Secret/Env in Hugging Face 
# before the Space builds so that it gets embedded correctly here.
RUN npm run build

# Change ownership of the app to the non-root user
RUN chown -R user:user /app

# Switch to the non-root user
USER user

# Set port variable for Next.js to use
ENV PORT=7860
EXPOSE 7860

CMD ["npm", "start"]
